# ---------------------------------------------------------------------------
# Njiani — build-time configuration template
#
#   cp .env.example .env.local
#
# Then fill in ONLY the keys the component you are testing needs. Every key is
# blank here on purpose. `.env.local` is git-ignored and never committed.
#
# The apps read this file at build time:
#   flutter run --dart-define-from-file=../../.env.local
#
# docs/CREDENTIALS.md says where each value comes from and when it is needed.
# The boot screen shows you which ones are still unset, on the device.
# ---------------------------------------------------------------------------

# Build environment: local | dev | prod
APP_ENV=local

# --- Supabase — needed at C3 -----------------------------------------------
# Dashboard -> Project Settings -> API
# For local work, `supabase start` prints a URL and anon key you can use here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- SMS gateway (Beem Africa) — needed at C4 ------------------------------
# SERVER-SIDE ONLY. These are Supabase Edge Function secrets, set with
# `supabase secrets set`, and are never compiled into the app. Listed here so
# the full set lives in one place.
#
#   supabase secrets set SMS_PROVIDER=console SEND_SMS_HOOK_SECRET='v1,whsec_...' #     BEEM_API_KEY='' BEEM_SECRET_KEY='' BEEM_SENDER_ID=NJIANI
#
# SMS_PROVIDER=console logs the code and sends nothing, which is enough to
# build and test the whole sign-in flow at zero cost. It is the default
# deliberately: a half-finished configuration must not quietly start spending.
SMS_PROVIDER=console

# Authentication → Hooks → Send SMS hook shows this as `v1,whsec_...`.
# Without it the function refuses to send, because anyone who learned its URL
# could otherwise spend Njiani's SMS credit.
SEND_SMS_HOOK_SECRET=

BEEM_API_KEY=
BEEM_SECRET_KEY=
# The registered sender ID. Beem rejects an unregistered source_addr, so this
# has to be approved before SMS_PROVIDER=beem will work at all.
BEEM_SENDER_ID=

# --- Maps and routing — needed at C14 --------------------------------------
# Self-hosted Protomaps .pmtiles URL, and your own OSRM instance.
MAP_TILE_URL=
OSRM_BASE_URL=

# --- Error tracking — needed at C17 ----------------------------------------
# Leave blank to keep Sentry disabled. The app runs normally without it.
SENTRY_DSN=
